{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/domain/**/*",
    "src/import/**/*",
    "src/storage/**/*",
    "src/export/**/*",
    "tests/unit/**/*",
    "tests/property/**/*",
    "tests/integration/**/*",
    "tests/e2e/**/*"
  ]
}
